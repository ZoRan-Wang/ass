row.names(wh) <- wh$Country
wh1 <- dplyr::select(wh, c(3, 7:12))
wh_matrix <- data.matrix(wh)
clean_wh_matrix <- function(df, drop_cols) {
x <- df[, -drop_cols]
# 强制转数值
x <- as.data.frame(lapply(x, as.numeric))
# 去除全 NA 列
x <- x[, colSums(!is.na(x)) > 0]
# 去除零方差列
x <- x[, apply(x, 2, sd, na.rm = TRUE) > 0]
# 转为 matrix
x <- as.matrix(x)
mode(x) <- "numeric"
x
}
wh_matrix <- clean_wh_matrix(
wh_matrix,
drop_cols = c(1, 2, 4, 5)
)
row.names(wh) <- wh$Country
wh1 <- dplyr::select(wh, c(3, 7:12))
wh_matrix <- data.matrix(wh)
clean_wh_matrix <- function(df, drop_cols) {
x <- df[, -drop_cols]
# 强制数值
x <- as.data.frame(lapply(x, as.numeric))
# 转 matrix（关键顺序）
x <- as.matrix(x)
mode(x) <- "numeric"
# 去除全 NA 列
x <- x[, colSums(!is.na(x)) > 0, drop = FALSE]
# 去除零方差列
x <- x[, apply(x, 2, sd, na.rm = TRUE) > 0, drop = FALSE]
x
}
wh_matrix <- clean_wh_matrix(
wh_matrix,
drop_cols = c(1, 2, 4, 5)
)
wh_heatmap <- heatmap(wh_matrix,
Rowv=NA, Colv=NA)
row.names(wh) <- wh$Country
wh_numeric <- wh[, c(3, 7:12)]
clean_wh_matrix <- function(df) {
x <- as.data.frame(lapply(df, as.numeric))
row.names(x) <- row.names(df)
x <- as.matrix(x)
mode(x) <- "numeric"
x <- x[, colSums(!is.na(x)) > 0, drop = FALSE]
x <- x[, apply(x, 2, sd, na.rm = TRUE) > 0, drop = FALSE]
x
}
wh_matrix <- clean_wh_matrix(wh_numeric)
